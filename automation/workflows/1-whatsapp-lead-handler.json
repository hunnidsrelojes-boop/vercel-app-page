{
  "name": "Hunnids - WhatsApp Lead Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": ["GET", "POST"],
        "path": "hunnids-whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "hunnids-whatsapp-inbound"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"},
          "conditions": [
            {
              "id": "cond-verify-1",
              "leftValue": "={{ $json.query && $json.query['hub.mode'] }}",
              "rightValue": "subscribe",
              "operator": {"type": "string", "operation": "equals"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000002",
      "name": "Is Verification",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {"responseCode": 200}
      },
      "id": "a1000000-0000-0000-0000-000000000003",
      "name": "Respond Verification",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [440, 180]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst entry = (body.entry && body.entry[0]) || {};\nconst change = (entry.changes && entry.changes[0]) || {};\nconst value = change.value || {};\nconst message = (value.messages && value.messages[0]) || null;\nconst contact = (value.contacts && value.contacts[0]) || {};\n\nif (!message || message.type !== 'text') {\n  return [{ json: { hasMessage: false } }];\n}\n\nreturn [{\n  json: {\n    hasMessage: true,\n    from: message.from,\n    name: (contact.profile && contact.profile.name) || '',\n    text: message.text.body,\n    messageId: message.id,\n    timestamp: message.timestamp,\n    phoneNumberId: (value.metadata && value.metadata.phone_number_id) || ''\n  }\n}];"
      },
      "id": "a1000000-0000-0000-0000-000000000004",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"},
          "conditions": [
            {
              "id": "cond-hasmsg-1",
              "leftValue": "={{ $json.hasMessage }}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "true", "singleValue": true}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000005",
      "name": "Has Message",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 400]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "EVENT_RECEIVED",
        "options": {"responseCode": 200}
      },
      "id": "a1000000-0000-0000-0000-000000000006",
      "name": "Respond Ack No Message",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, 500]
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\n\nconst systemPrompt = 'Eres el asistente de ventas de Hunnids, una tienda de relojes. Analiza el mensaje del cliente y responde SOLO con un JSON valido (sin markdown, sin backticks) con estos campos: classification (uno de: lead, seguimiento, soporte, otro), interest_summary (breve resumen de que reloj o marca busca, si aplica), urgency (alta, media o baja), suggested_reply (una respuesta breve, calida y en espanol, lista para enviar por WhatsApp, que continue la conversacion y pida el dato que falte, por ejemplo modelo, presupuesto o disponibilidad).';\n\nreturn [{\n  json: {\n    requestBody: {\n      model: 'claude-sonnet-5',\n      max_tokens: 600,\n      system: systemPrompt,\n      messages: [\n        { role: 'user', content: msg.text }\n      ]\n    }\n  }\n}];"
      },
      "id": "a1000000-0000-0000-0000-000000000007",
      "name": "Build Claude Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "anthropic-version", "value": "2023-06-01"},
            {"name": "content-type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.requestBody }}",
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000008",
      "name": "Classify with Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 300],
      "credentials": {
        "httpHeaderAuth": {"id": "REPLACE_ME", "name": "Anthropic API (x-api-key)"}
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.content[0].text;\nlet cleaned = raw.trim();\nif (cleaned.startsWith('```')) {\n  cleaned = cleaned.replace(/^```(json)?/i, '').replace(/```$/, '').trim();\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    classification: 'otro',\n    interest_summary: '',\n    urgency: 'media',\n    suggested_reply: 'Gracias por tu mensaje, en breve te contactamos con mas informacion.'\n  };\n}\n\nconst prev = $('Extract Message').first().json;\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    fecha: now,\n    canal: 'whatsapp',\n    nombre: prev.name || '',\n    telefono: prev.from,\n    mensaje: prev.text,\n    clasificacion: parsed.classification,\n    interes: parsed.interest_summary,\n    urgencia: parsed.urgency,\n    estado: 'nuevo',\n    ultimo_contacto: now,\n    follow_up_count: 0,\n    suggested_reply: parsed.suggested_reply,\n    phoneNumberId: prev.phoneNumberId,\n    message_id: prev.messageId\n  }\n}];"
      },
      "id": "a1000000-0000-0000-0000-000000000009",
      "name": "Parse Claude Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {"__rl": true, "mode": "id", "value": "REPLACE_WITH_YOUR_SHEET_ID"},
        "sheetName": {"__rl": true, "mode": "name", "value": "Leads"},
        "columns": {"mappingMode": "autoMapInputData", "value": {}, "matchingColumns": [], "schema": []},
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000010",
      "name": "Log Lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1540, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {"id": "REPLACE_ME", "name": "Google Sheets - Hunnids"}
      }
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nreturn [{\n  json: {\n    to: d.telefono,\n    text: d.suggested_reply,\n    phoneNumberId: d.phoneNumberId\n  }\n}];"
      },
      "id": "a1000000-0000-0000-0000-000000000011",
      "name": "Build WhatsApp Reply Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.phoneNumberId }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Content-Type", "value": "application/json"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { messaging_product: 'whatsapp', to: $json.to, text: { body: $json.text } } }}",
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000012",
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 300],
      "credentials": {
        "httpBearerAuth": {"id": "REPLACE_ME", "name": "Meta Graph API Token"}
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose"},
          "conditions": [
            {
              "id": "cond-highintent-1",
              "leftValue": "={{ $('Parse Claude Response').item.json.clasificacion }}",
              "rightValue": "lead",
              "operator": {"type": "string", "operation": "equals"}
            },
            {
              "id": "cond-highintent-2",
              "leftValue": "={{ $('Parse Claude Response').item.json.urgencia }}",
              "rightValue": "alta",
              "operator": {"type": "string", "operation": "equals"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000013",
      "name": "Is High Intent",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2200, 300]
    },
    {
      "parameters": {
        "jsCode": "// TIP: reemplaza este numero por tu WhatsApp personal (con codigo de pais, sin +, ej '5215512345678')\nconst OWNER_WHATSAPP_NUMBER = 'REPLACE_WITH_OWNER_NUMBER';\n\nconst lead = $('Parse Claude Response').first().json;\n\nreturn [{\n  json: {\n    to: OWNER_WHATSAPP_NUMBER,\n    text: 'Nuevo lead caliente. Nombre: ' + (lead.nombre || 'sin nombre') + '. Tel: ' + lead.telefono + '. Interes: ' + lead.interes + '. Mensaje: ' + lead.mensaje,\n    phoneNumberId: lead.phoneNumberId\n  }\n}];"
      },
      "id": "a1000000-0000-0000-0000-000000000014",
      "name": "Build Owner Notify Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2420, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.phoneNumberId }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Content-Type", "value": "application/json"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { messaging_product: 'whatsapp', to: $json.to, text: { body: $json.text } } }}",
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000015",
      "name": "Notify Owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2640, 200],
      "credentials": {
        "httpBearerAuth": {"id": "REPLACE_ME", "name": "Meta Graph API Token"}
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "EVENT_RECEIVED",
        "options": {"responseCode": 200}
      },
      "id": "a1000000-0000-0000-0000-000000000016",
      "name": "Respond Ack Final",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2860, 300]
    }
  ],
  "connections": {
    "Webhook": {"main": [[{"node": "Is Verification", "type": "main", "index": 0}]]},
    "Is Verification": {
