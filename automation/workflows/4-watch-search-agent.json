      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { query: $('Normalize Input').item.json.query, count: $('Format Results Message').item.json.results.length, results: $('Format Results Message').item.json.results } }}",
        "options": {"responseCode": 200}
      },
