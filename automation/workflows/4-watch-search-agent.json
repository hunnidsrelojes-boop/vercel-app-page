        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {"name": "grant_type", "value": "client_credentials"},
            {"name": "scope", "value": "https://api.ebay.com/oauth/api_scope"}
          ]
        },
        "options": {}
      },
      "id": "d1000000-0000-0000-0000-000000000003",
      "name": "Get eBay Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 200],
      "credentials": {
        "httpBasicAuth": {"id": "REPLACE_ME", "name": "eBay API Client Credentials"}
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.ebay.com/buy/browse/v1/item_summary/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {"name": "q", "value": "={{ $('Normalize Input').item.json.query }}"},
            {"name": "limit", "value": "10"}
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "=Bearer {{ $json.access_token }}"},
            {"name": "X-EBAY-C-MARKETPLACE-ID", "value": "EBAY_US"}
          ]
        },
        "options": {},
        "onError": "continueRegularOutput"
      },
      "id": "d1000000-0000-0000-0000-000000000004",
      "name": "Search eBay",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 200]
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst items = resp.itemSummaries || [];\nconst maxPrice = $('Normalize Input').item.json.max_price;\n\nconst results = items.map(it => ({\n  source: 'eBay',\n  title: it.title,\n  price: it.price ? Number(it.price.value) : null,\n  currency: it.price ? it.price.currency : '',\n  url: it.itemWebUrl\n})).filter(r => r.price !== null && (!maxPrice || r.price <= maxPrice));\n\nreturn results.map(r => ({ json: r }));"
      },
      "id": "d1000000-0000-0000-0000-000000000005",
      "name": "Parse eBay Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.jomashop.com/catalogsearch/result/",
        "sendQuery": true,
        "queryParameters": {"parameters": [{"name": "q", "value": "={{ $('Normalize Input').item.json.query }}"}]},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "User-Agent", "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"}
          ]
        },
        "options": {},
        "onError": "continueRegularOutput"
      },
      "id": "d1000000-0000-0000-0000-000000000006",
      "name": "Search Jomashop",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 400]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "json",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {"key": "title", "cssSelector": ".product-item-link", "returnValue": "text", "returnArray": true},
            {"key": "price", "cssSelector": ".price", "returnValue": "text", "returnArray": true},
            {"key": "link", "cssSelector": "a.product-item-link", "returnValue": "attribute", "attribute": "href", "returnArray": true}
          ]
        },
        "options": {"trimValues": true}
      },
      "id": "d1000000-0000-0000-0000-000000000007",
      "name": "Parse Jomashop HTML",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [660, 400],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst titles = Array.isArray(data.title) ? data.title : (data.title ? [data.title] : []);\nconst prices = Array.isArray(data.price) ? data.price : (data.price ? [data.price] : []);\nconst links = Array.isArray(data.link) ? data.link : (data.link ? [data.link] : []);\nconst maxPrice = $('Normalize Input').item.json.max_price;\n\nconst results = [];\nfor (let i = 0; i < titles.length; i++) {\n  const priceNum = parseFloat((prices[i] || '').toString().replace(/[^0-9.]/g, ''));\n  if (isNaN(priceNum)) continue;\n  if (maxPrice && priceNum > maxPrice) continue;\n  let url = links[i] || '';\n  if (url && url.startsWith('/')) url = 'https://www.jomashop.com' + url;\n  results.push({ source: 'Jomashop', title: (titles[i] || '').trim(), price: priceNum, currency: 'USD', url });\n}\n\nreturn results.map(r => ({ json: r }));"
      },
      "id": "d1000000-0000-0000-0000-000000000008",
      "name": "Normalize Jomashop Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.chrono24.com/search/index.htm",
        "sendQuery": true,
        "queryParameters": {"parameters": [{"name": "query", "value": "={{ $('Normalize Input').item.json.query }}"}]},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "User-Agent", "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"}
