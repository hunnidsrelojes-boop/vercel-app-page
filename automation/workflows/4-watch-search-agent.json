    {
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "json",
        "dataPropertyName": "data",
        "extractionValues": {
          "values": [
            {"key": "title", "cssSelector": ".article-title", "returnValue": "text", "returnArray": true},
            {"key": "price", "cssSelector": ".price-elem, .article-price", "returnValue": "text", "returnArray": true},
            {"key": "link", "cssSelector": "a.article-item", "returnValue": "attribute", "attribute": "href", "returnArray": true}
          ]
        },
        "options": {"trimValues": true}
      },
      "id": "d1000000-0000-0000-0000-000000000010",
      "name": "Parse Chrono24 HTML",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [660, 600],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst titles = Array.isArray(data.title) ? data.title : (data.title ? [data.title] : []);\nconst prices = Array.isArray(data.price) ? data.price : (data.price ? [data.price] : []);\nconst links = Array.isArray(data.link) ? data.link : (data.link ? [data.link] : []);\nconst maxPrice = $('Normalize Input').item.json.max_price;\n\nconst results = [];\nfor (let i = 0; i < titles.length; i++) {\n  const priceNum = parseFloat((prices[i] || '').toString().replace(/[^0-9.]/g, ''));\n  if (isNaN(priceNum)) continue;\n  if (maxPrice && priceNum > maxPrice) continue;\n  let url = links[i] || '';\n  if (url && url.startsWith('/')) url = 'https://www.chrono24.com' + url;\n  results.push({ source: 'Chrono24', title: (titles[i] || '').trim(), price: priceNum, currency: 'USD', url });\n}\n\nreturn results.map(r => ({ json: r }));"
      },
      "id": "d1000000-0000-0000-0000-000000000011",
      "name": "Normalize Chrono24 Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 600]
    },
    {
      "parameters": {
        "mode": "append",
        "numberInputs": 3,
        "options": {}
      },
      "id": "d1000000-0000-0000-0000-000000000012",
      "name": "Merge Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1100, 400]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst q = $('Normalize Input').item.json.query;\n\nif (items.length === 0) {\n  return [{ json: { text: 'No encontre resultados para \"' + q + '\". Puede que el sitio haya bloqueado la busqueda automatica o que no haya stock ahora mismo.', results: [] } }];\n}\n\nitems.sort((a, b) => (a.price || 0) - (b.price || 0));\nconst top = items.slice(0, 10);\n\nlet text = 'Resultados para \"' + q + '\" (' + items.length + ' encontrados):\\n\\n';\ntop.forEach((r, idx) => {\n  text += (idx + 1) + '. [' + r.source + '] ' + r.title + ' - $' + r.price + ' ' + r.currency + '\\n' + r.url + '\\n\\n';\n});\n\nreturn [{ json: { text, results: items } }];"
      },
      "id": "d1000000-0000-0000-0000-000000000013",
      "name": "Format Results Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 400]
    },
    {
      "parameters": {
        "jsCode": "// TIP: reemplaza estos valores por tu numero de WhatsApp y tu phone_number_id de Meta\nconst OWNER_WHATSAPP_NUMBER = 'REPLACE_WITH_OWNER_NUMBER';\nconst OWNER_PHONE_NUMBER_ID = 'REPLACE_WITH_YOUR_WHATSAPP_PHONE_NUMBER_ID';\n\nconst d = $input.first().json;\n\nreturn [{\n  json: {\n    to: OWNER_WHATSAPP_NUMBER,\n    text: d.text,\n    phoneNumberId: OWNER_PHONE_NUMBER_ID,\n    results: d.results\n  }\n}];"
      },
      "id": "d1000000-0000-0000-0000-000000000014",
      "name": "Build WhatsApp Summary Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.phoneNumberId }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Content-Type", "value": "application/json"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { messaging_product: 'whatsapp', to: $json.to, text: { body: $json.text } } }}",
        "options": {},
        "onError": "continueRegularOutput"
      },
      "id": "d1000000-0000-0000-0000-000000000015",
      "name": "Send WhatsApp Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 400],
      "credentials": {
        "httpBearerAuth": {"id": "REPLACE_ME", "name": "Meta Graph API Token"}
      }
    },
